# =============================================================================
# Figma MCP Server - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# -----------------------------------------------------------------------------
# REQUIRED: Figma Personal Access Token
# Get one at: https://www.figma.com/developers/api#access-tokens
# -----------------------------------------------------------------------------
FIGMA_ACCESS_TOKEN=figd_your_personal_access_token_here

# -----------------------------------------------------------------------------
# OPTIONAL: HTTP Server Authentication
# Set MCP_API_KEY to enable API key authentication on /mcp endpoint
# -----------------------------------------------------------------------------
# MCP_API_KEY=your-secure-random-api-key-here

# Optional: Comma-separated list of allowed IPs (CIDR or exact)
# MCP_ALLOWED_IPS=127.0.0.1,::1,10.0.0.0/8

# -----------------------------------------------------------------------------
# OPTIONAL: Rate Limiting (Server-side per-client)
# Stricter than Figma's 30 req/s to protect shared token
# -----------------------------------------------------------------------------
# MCP_RATE_LIMIT_RPS=10
# MCP_RATE_LIMIT_BURST=10

# -----------------------------------------------------------------------------
# OPTIONAL: Logging Levels
# Options: debug, info, warn, error
# -----------------------------------------------------------------------------
# MCP_LOG_LEVEL=info
# FIGMA_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# OPTIONAL: Server Configuration
# -----------------------------------------------------------------------------
# PORT=3000
# HOST=0.0.0.0
# MCP_PATH=/mcp