{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@figma-mcp/*": ["./figma-context-engine/packages/$1/src/index.ts"]
    }
  },
  "include": ["figma-context-engine/**/*"],
  "exclude": ["node_modules", "dist"]
}